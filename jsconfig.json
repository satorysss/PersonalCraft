{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "baseUrl": "src",

    "paths": {
      "@/*": ["*"],
      "pages/*": ["pages/*"],
      "shared/*": ["shared/*"],
      "app/*": ["app/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["src"]
}
